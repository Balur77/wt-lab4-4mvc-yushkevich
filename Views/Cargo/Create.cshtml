    
@model wt_lab4_4mvc_yushkevich.Models.Cargo

@{
    ViewData["Title"] = "Добавление груза";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none">
                    ← Вернуться к каталогу
                </a>
            </div>

            <div class="card border-0 shadow rounded-4">
                <div class="card-body p-4 p-md-5">
                    <span class="badge bg-primary mb-2">Новая позиция</span>
                    <h1 class="h2 fw-bold mb-2">Добавление груза</h1>

                    <p class="text-secondary mb-4">
                        Заполните характеристики груза для учёта на складе.
                    </p>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Название груза
                            </label>
                            <input asp-for="Name" class="form-control"
                                   placeholder="Например, Ноутбуки" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label">
                                Категория
                            </label>
                            <input asp-for="Category" class="form-control"
                                   placeholder="Например, Электроника" />
                            <span asp-validation-for="Category"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Quantity" class="form-label">
                                    Количество единиц
                                </label>
                                <input asp-for="Quantity" type="number"
                                       min="1" class="form-control" />
                                <span asp-validation-for="Quantity"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Weight" class="form-label">
                                    Общий вес, кг
                                </label>
                                <input asp-for="Weight" type="number"
                                       min="0.01" step="0.01"
                                       class="form-control" />
                                <span asp-validation-for="Weight"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label">
                                Место хранения
                            </label>
                            <input asp-for="Location" class="form-control"
                                   placeholder="Например, Сектор A-1" />
                            <span asp-validation-for="Location"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Описание
                            </label>
                            <textarea asp-for="Description" rows="3"
                                      class="form-control"
                                      placeholder="Краткое описание груза"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsAvailable"
                                   class="form-check-input" />
                            <label asp-for="IsAvailable"
                                   class="form-check-label">
                                Груз доступен
                            </label>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">
                                Сохранить груз
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
